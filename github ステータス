<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>GitHub 状況確認くん</title>
    <style>
        :root { --ok: #2da44e; --warn: #bf8700; --error: #cf222e; --bg: #f6f8fa; }
        body { font-family: "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: #24292f; margin: 0; padding: 20px; }
        .container { max-width: 800px; margin: 0 auto; }
        
        /* メインバナー */
        .status-hero { text-align: center; padding: 30px; border-radius: 16px; margin-bottom: 20px; color: white; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .status-hero.none { background: var(--ok); }
        .status-hero.minor { background: var(--warn); }
        .status-hero.major { background: var(--error); }
        .status-hero h1 { margin: 0; font-size: 2rem; }

        .card { background: white; border: 1px solid #d0d7de; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
        h2 { font-size: 1.1rem; margin-top: 0; border-left: 4px solid #24292f; padding-left: 10px; margin-bottom: 15px; }

        /* サービス一覧 */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
        .item { padding: 12px; border-radius: 8px; border: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center; background: #fff; }
        .status-tag { font-size: 0.8rem; font-weight: bold; padding: 3px 8px; border-radius: 6px; border: 1px solid currentColor; }

        /* 履歴部分 */
        .history-item { border-bottom: 1px solid #eee; padding: 15px 0; }
        .history-item:last-child { border-bottom: none; }
        .time { font-size: 0.8rem; color: #666; font-weight: bold; }
        .title-ja { font-weight: bold; display: block; margin: 5px 0; color: #d73a49; font-size: 1.1rem; }
        .desc-ja { background: #fdf6ec; padding: 12px; border-radius: 8px; font-size: 0.95rem; border: 1px solid #faecd8; color: #444; line-height: 1.6; }
        
        .refresh-info { text-align: center; font-size: 0.8rem; color: #888; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <div id="hero" class="status-hero none">
        <h1 id="hero-title">チェック中...</h1>
        <p id="hero-desc">データを読み込んでいます</p>
    </div>

    <div class="card">
        <h2>🛠 サービス別の状態</h2>
        <div id="components" class="grid"></div>
    </div>

    <div class="card">
        <h2>📝 最近の出来事（日本語要約）</h2>
        <div id="history">取得中...</div>
    </div>

    <div id="last-update" class="refresh-info"></div>
</div>

<script>
    // 単語ごとの変換辞書
    const DICT = {
        "All Systems Operational": "✅ すべて正常です",
        "Minor Service Outage": "⚠️ 一部で問題が発生中",
        "Partial System Outage": "❌ システムの一部が停止中",
        "Major Service Outage": "🚨 大規模な障害が発生中",
        "Disruption with some GitHub services": "一部サービスでの混乱・不具合",
        "Incident with Codespaces": "Codespacesでのトラブル",
        "operational": "正常",
        "degraded_performance": "動作が重い",
        "partial_outage": "一部停止",
        "major_outage": "停止中",
        "investigating": "調査中",
        "identified": "原因特定済み",
        "monitoring": "監視中",
        "resolved": "解決済み",
        "Git Operations": "Git操作(Push/Pull)",
        "API Requests": "API接続",
        "GitHub Actions": "自動ビルド(Actions)",
        "GitHub Pages": "Pagesサイト公開",
        "Pull Requests": "プルリク",
        "Issues": "イシュー(掲示板)",
        "Copilot": "AI補完(Copilot)",
        "Webhooks": "外部連携(Webhook)",
        "Codespaces": "クラウド開発環境(Codespaces)"
    };

    // 文章全体の置き換え（スクショの英語に対応）
    function translateFullText(text) {
        if (!text) return "詳細情報はありません。";
        let t = text;
        
        // よく出るフレーズを日本語に
        t = t.replace(/We have isolated a problematic component in our infrastructure/gi, "インフラ内の問題箇所を特定・切り離しました");
        t = t.replace(/and are working to mitigate/gi, "。現在、影響を最小限にするための作業を行っています。");
        t = t.replace(/We will continue to post updates as we work toward resolution/gi, "解決に向けて引き続き状況を報告します。");
        t = t.replace(/This incident has been resolved/gi, "この件は解決しました。");
        t = t.replace(/Thank you for your patience and understanding as we addressed this issue/gi, "対応中のご協力ありがとうございました。");
        t = t.replace(/A detailed root cause analysis will be shared as soon as it is available/gi, "詳細な原因分析は準備ができ次第公開されます。");
        t = t.replace(/We are investigating reports of/gi, "調査を開始しました：");
        t = t.replace(/is experiencing degraded performance/gi, "の動作が遅くなっています。");
        
        return t;
    }

    async function updateStatus() {
        try {
            const [sRes, iRes] = await Promise.all([
                fetch('https://www.githubstatus.com/api/v2/summary.json'),
                fetch('https://www.githubstatus.com/api/v2/incidents.json')
            ]);
            const sData = await sRes.json();
            const iData = await iRes.json();

            // 1. メイン状況
            const hero = document.getElementById('hero');
            const hTitle = document.getElementById('hero-title');
            const statusType = sData.status.indicator;
            hero.className = `status-hero ${statusType}`;
            hTitle.innerText = DICT[sData.status.description] || sData.status.description;
            document.getElementById('hero-desc').innerText = statusType === 'none' ? "安心して作業できます" : "状況を確認してください";

            // 2. サービス一覧
            const compDiv = document.getElementById('components');
            compDiv.innerHTML = '';
            sData.components.slice(0, 9).forEach(c => {
                if(c.name.includes("Visit")) return;
                const div = document.createElement('div');
                div.className = 'item';
                const color = c.status === 'operational' ? 'var(--ok)' : 'var(--error)';
                div.innerHTML = `
                    <span>${DICT[c.name] || c.name}</span>
                    <span class="status-tag" style="color:${color}">${DICT[c.status] || c.status}</span>
                `;
                compDiv.appendChild(div);
            });

            // 3. 履歴（文章置換を適用）
            const histDiv = document.getElementById('history');
            histDiv.innerHTML = '';
            iData.incidents.slice(0, 3).forEach(inc => {
                const date = new Date(inc.created_at).toLocaleString();
                const latestUpdate = inc.incident_updates[0] ? inc.incident_updates[0].body : "";
                
                const html = `
                    <div class="history-item">
                        <span class="time">${date}</span>
                        <span class="title-ja">${DICT[inc.name] || inc.name}</span>
                        <div style="font-size:0.8rem; margin-bottom:5px;">進捗: <b>${DICT[inc.status] || inc.status}</b></div>
                        <div class="desc-ja">${translateFullText(latestUpdate)}</div>
                    </div>
                `;
                histDiv.insertAdjacentHTML('beforeend', html);
            });

            document.getElementById('last-update').innerText = "最終確認: " + new Date().toLocaleTimeString();
        } catch (e) {
            document.getElementById('hero-title').innerText = "エラー：データが取れません";
        }
    }

    setInterval(updateStatus, 60000);
    updateStatus();
</script>
</body>
</html>