<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Loading...</title>
    <style>
        html, body { margin: 0; padding: 0; width: 100%; height: 100dvh; background: #000; overflow: hidden; }
        #l { position: fixed; top: 0; left: 0; width: 100%; height: 100dvh; display: flex; justify-content: center; align-items: center; color: #fff; font-family: sans-serif; z-index: 9999; }
    </style>
</head>
<body>
    <div id="l">読み込み中...</div>
    <script>
    (async function(){
        try {
            const d = {"ct":"","iv":"AUV4ShZz8HKv8CWu","key":"FftSVBZCRkD3kHILkbhrwQ=="};
            const key = await window.crypto.subtle.importKey("raw", new Uint8Array(atob(d.key).split("").map(c=>c.charCodeAt(0))), "AES-GCM", false, ["decrypt"]);
            const pt = await window.crypto.subtle.decrypt({name:"AES-GCM",iv:new Uint8Array(atob(d.iv).split("").map(c=>c.charCodeAt(0)))}, key, new Uint8Array(atob(d.ct).split("").map(c=>c.charCodeAt(0))));
            const fullHtml = new TextDecoder().decode(pt);
            
            const parser = new DOMParser();
            const newDoc = parser.parseFromString(fullHtml, 'text/html');

            // 1. Head内容をすべて移植（スマホ用meta設定を含む）
            document.head.innerHTML = newDoc.head.innerHTML;
            
            // 2. Bodyの書き換え
            document.body.innerHTML = newDoc.body.innerHTML;
            
            // 3. インラインおよび外部スクリプトの完全な再実行
            const scripts = Array.from(newDoc.querySelectorAll("script"));
            for (let oldScript of scripts) {
                const newScript = document.createElement("script");
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                if (oldScript.src) {
                    newScript.src = oldScript.src;
                    // 外部スクリプトの読み込み完了を待機するための処理（必要に応じて）
                } else {
                    newScript.textContent = oldScript.textContent;
                }
                document.body.appendChild(newScript);
            }
        } catch(e) {
            document.body.innerHTML = "<div style='color:white;text-align:center;padding:50px;'>エラーが発生しました</div>";
        }
    })();
    </script>
</body>
</html>